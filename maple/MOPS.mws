{MPLTEXT 1 0 76 "`MOPS/evalJack`:=proc(a,l,x) local uvalid,u,result,te
rm,ls,us,i,j,ab,lc,uc;\n" }{MPLTEXT 1 0 18 "#option remember;\n" }
{MPLTEXT 1 0 45 "  if(nops(l)>nops(x)) then return 0; end if;\n" }
{MPLTEXT 1 0 36 "  if(l = []) then return 1; end if;\n" }{MPLTEXT 1 0 
21 "  if(nops(x)=1) then\n" }{MPLTEXT 1 0 58 "    #if(nops(l)>1 and l[
2] != 0) then return 0; end if;  \n" }{MPLTEXT 1 0 74 "    return simp
lify((x[1]^l[1])*(a^(l[1]-1))*`MOPS/SFact`(1/a+1,l[1]-1));\n" }
{MPLTEXT 1 0 10 "  end if;\n" }{MPLTEXT 1 0 18 "  #compute uvalid\n" }
{MPLTEXT 1 0 46 "  uvalid := `MOPS/egen`(`MOPS/conjugate`(l));\n" }
{MPLTEXT 1 0 18 "  #print(uvalid);\n" }{MPLTEXT 1 0 30 "  ls:=sum(l[i]
,i=1..nops(l));\n" }{MPLTEXT 1 0 27 "  lc:=`MOPS/conjugate`(l);\n" }
{MPLTEXT 1 0 15 "  result := 0;\n" }{MPLTEXT 1 0 21 "  for u in uvalid
 do\n" }{MPLTEXT 1 0 30 "    u := `MOPS/conjugate`(u);\n" }{MPLTEXT 1 
0 15 "    #print(u);\n" }{MPLTEXT 1 0 59 "    us:=0; for j from 1 to n
ops(u) do us:=us+u[j]; end do;\n" }{MPLTEXT 1 0 29 "    uc:=`MOPS/conj
ugate`(u);\n" }{MPLTEXT 1 0 16 "    #compute AB\n" }{MPLTEXT 1 0 14 " \+
   ab:=1;   \n" }{MPLTEXT 1 0 31 "    for i from 1 to nops(u) do\n" }
{MPLTEXT 1 0 31 "       for j from 1 to u[i] do\n" }{MPLTEXT 1 0 21 " \+
       #print(i,j);\n" }{MPLTEXT 1 0 66 "        if (j <= nops(uc) and
 j <= nops(lc) and lc[j]=uc[j]) then\n" }{MPLTEXT 1 0 51 "          ab
:=ab/(uc[j]-i+a*(u[i]-j+1));          \n" }{MPLTEXT 1 0 13 "        el
se\n" }{MPLTEXT 1 0 51 "          ab:=ab/(uc[j]-i+1+a*(u[i]-j));      \+
    \n" }{MPLTEXT 1 0 15 "        end if\n" }{MPLTEXT 1 0 16 "      en
d do;  \n" }{MPLTEXT 1 0 12 "    end do;\n" }{MPLTEXT 1 0 31 "    for \+
i from 1 to nops(l) do\n" }{MPLTEXT 1 0 30 "      for j from 1 to l[i]
 do\n" }{MPLTEXT 1 0 66 "        if (j <= nops(uc) and j <= nops(lc) a
nd lc[j]=uc[j]) then\n" }{MPLTEXT 1 0 51 "          ab:=ab*(lc[j]-i+a*
(l[i]-j+1));          \n" }{MPLTEXT 1 0 13 "        else\n" }{MPLTEXT 
1 0 51 "          ab:=ab*(lc[j]-i+1+a*(l[i]-j));          \n" }
{MPLTEXT 1 0 15 "        end if\n" }{MPLTEXT 1 0 16 "      end do;  \n
" }{MPLTEXT 1 0 12 "    end do;\n" }{MPLTEXT 1 0 16 "    #print(ab);\n
" }{MPLTEXT 1 0 21 "    #multiply & add \n" }{MPLTEXT 1 0 76 "    term
:=(x[nops(x)]^(ls-us))*ab*`MOPS/evalJack`(a,u,x[1..nops(x)-1]);    \n"
 }{MPLTEXT 1 0 18 "    #print(term);\n" }{MPLTEXT 1 0 32 "    result:=
result+term;       \n" }{MPLTEXT 1 0 10 "  end do;\n" }{MPLTEXT 1 0 
17 "  return result;\n" }{MPLTEXT 1 0 9 "end proc;" }}{PARA 11 "" 1 ""
